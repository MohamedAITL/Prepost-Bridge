{
  "manifest_version": 3,
  "name": "Prepost Bridge",
  "version": "1.4.0",
  "description": "Lets the local Prepost engine prepare posts in tabs it opens in this Chrome profile, and sends image+caption messages from chosen WhatsApp chats to Prepost.",
  "permissions": ["debugger", "tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Prepost Bridge", "default_popup": "popup.html" },
  "minimum_chrome_version": "125"
}
